# Скопируй в .env и заполни. .env в .gitignore — НЕ коммитить.

# --- Replicate (нужно для Недели 0) ---
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPLICATE_USERNAME=your-replicate-username

# --- Yandex Object Storage (S3) ---
YOS_ACCESS_KEY_ID=
YOS_SECRET_ACCESS_KEY=
YOS_BUCKET_NAME=photo-ai-prod
YOS_ENDPOINT=https://storage.yandexcloud.net
YOS_REGION=ru-central1

# --- Робокасса ---
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_IS_TEST=1

# --- Email (Yandex SMTP) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@yoursite.ru
SMTP_PASS=
FROM_EMAIL=noreply@yoursite.ru

# --- App ---
BASE_URL=http://localhost:8000
SECRET_KEY=change-me
DATABASE_PATH=./data/photo_ai.db
